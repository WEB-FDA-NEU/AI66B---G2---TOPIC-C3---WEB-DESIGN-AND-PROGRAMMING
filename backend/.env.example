# Copy to backend/.env. Never commit real secrets or production credentials.
APP_ENV=development
# Empty uses backend/luxstay.db, deliberately distinct from the old dev.db.
DATABASE_URL=
# Empty in development generates a private .local-secret once. Required >=32 random bytes in production.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
AUTH_RATE_LIMIT=20
SERVE_FRONTEND=true
# Production example: APP_ENV=production, SERVE_FRONTEND=false,
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/luxstay
# JWT_SECRET=<a secret generated by a cryptographically secure secret manager>
